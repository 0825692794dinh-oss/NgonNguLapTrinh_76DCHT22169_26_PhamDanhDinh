#include <iostream>
#include <string>
#include <vector>
#include <iomanip>

using namespace std;

// Khai bao kiem du lieu cau truc NhanVien
struct NhanVien {
    string maNV;
    string tenNV;
    double luongCoBan;
    double heSo;
};

// Ham nhap thong tin cho n nhan vien
void nhap(vector<NhanVien>& dsNV, int n) {
    for (int i = 0; i < n; i++) {
        NhanVien nv;
        cout << "\n--- Nhap thong tin nhan vien thu " << i + 1 << " ---" << endl;
        
        cout << "Nhap ma nhan vien: ";
        cin >> nv.maNV;
        
        cin.ignore(); // Xoa bo nho dem truoc khi nhap chuoi co khoang trang
        cout << "Nhap ho va ten: ";
        getline(cin, nv.tenNV);
        
        cout << "Nhap luong co ban: ";
        cin >> nv.luongCoBan;
        
        cout << "Nhap he so luong: ";
        cin >> nv.heSo;
        
        dsNV.push_back(nv);
    }
}

// Ham xuat thong tin cho n nhan vien
void xuat(const vector<NhanVien>& dsNV) {
    cout << "\n=================== DANH SACH NHAN VIEN ===================" << endl;
    cout << left 
         << setw(12) << "Ma NV" 
         << setw(25) << "Ho va Ten" 
         << setw(18) << "Luong Co Ban" 
         << setw(10) << "He So" 
         << setw(18) << "Luong Thuc Linh" << endl;
    cout << string(83, '-') << endl;

    for (const auto& nv : dsNV) {
        double luongThucLinh = nv.luongCoBan * nv.heSo;
        cout << left 
             << setw(12) << nv.maNV 
             << setw(25) << nv.tenNV 
             << setw(18) << fixed << setprecision(0) << nv.luongCoBan 
             << setw(10) << setprecision(2) << nv.heSo 
             << setw(18) << setprecision(0) << luongThucLinh << endl;
    }
}

int main() {
    int n;
    cout << "Nhap so luong nhan vien (n): ";
    cin >> n;

    if (n <= 0) {
        cout << "So luong nhan vien phai lon hon 0!" << endl;
        return 0;
    }

    vector<NhanVien> dsNV;

    // Goi ham nhap va xuat
    nhap(dsNV, n);
    xuat(dsNV);

    return 0;
}
