        cin >> monHoc.CC;
        cout << "Diem kiem tra (KT): ";
        cin >> monHoc.KT;
        cout << "Diem thi (DT): ";
        cin >> monHoc.DT;
    }
    void xuat() const {
        cout << "\n====================================\n";
        cout << "THONG TIN SINH VIEN\n";
        cout << "====================================\n";
