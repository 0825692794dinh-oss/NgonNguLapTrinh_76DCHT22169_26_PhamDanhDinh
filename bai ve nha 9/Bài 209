        cout << "Ma SV: " << maSV << endl;
        cout << "Mon hoc: " << monHoc.tenMonHoc << endl;
        cout << "Diem chuyen can (CC): " << monHoc.CC << endl;
        cout << "Diem kiem tra (KT): " << monHoc.KT << endl;
        cout << "Diem thi (DT): " << monHoc.DT << endl;
        cout << "Diem hoc phan: " << tinhDiemHocPhan() << endl;
    }
};

