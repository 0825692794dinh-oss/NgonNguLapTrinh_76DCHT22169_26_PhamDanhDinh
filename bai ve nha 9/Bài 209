#include <iostream>
#include <string>

using namespace std;

class MonHoc {
public:
    string tenMonHoc;
    float CC;
    float KT;
    float DT;
    float tinhDiemHocPhan() const {
        return CC + KT + DT;
    }
};

class SinhVien {
