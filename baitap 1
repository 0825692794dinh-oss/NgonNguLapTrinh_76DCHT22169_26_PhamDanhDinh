#include <iostream>
using namespace std;

class MaTran
{
private:
    int soHang;
    int soCot;
    int a[100][100];

public:
    // Ham nhap
    void nhap()
    {
        cout << "Nhap so hang: ";
        cin >> soHang;

        cout << "Nhap so cot: ";
        cin >> soCot;

        cout << "Nhap cac phan tu:\n";

        for (int i = 0; i < soHang; i++)
        {
            for (int j = 0; j < soCot; j++)
            {
                cout << "a[" << i << "][" << j << "] = ";
                cin >> a[i][j];
            }
        }
    }

    // Ham xuat
    void xuat()
    {
        for (int i = 0; i < soHang; i++)
        {
            for (int j = 0; j < soCot; j++)
            {
                cout << a[i][j] << " ";
            }
            cout << endl;
        }
    }

    // Ham ban
    friend MaTran cong(MaTran A, MaTran B);
};

// Dinh nghia ham ban
MaTran cong(MaTran A, MaTran B)
{
    MaTran C;

    C.soHang = A.soHang;
    C.soCot = A.soCot;

    for (int i = 0; i < C.soHang; i++)
    {
        for (int j = 0; j < C.soCot; j++)
        {
            C.a[i][j] = A.a[i][j] + B.a[i][j];
        }
    }

    return C;
}

int main()
{
    MaTran A, B, C;

    cout << "===== NHAP MA TRAN A =====\n";
    A.nhap();

    cout << "\n===== NHAP MA TRAN B =====\n";
    B.nhap();

    // Goi ham ban de cong A va B
    C = cong(A, B);

    cout << "\n===== MA TRAN A =====\n";
    A.xuat();

    cout << "\n===== MA TRAN B =====\n";
    B.xuat();

    cout << "\n===== MA TRAN A + B =====\n";
    C.xuat();

    return 0;
}
